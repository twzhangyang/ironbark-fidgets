# Supabase project "ironbark-fidgets" (Sydney). Real values go in .env.local (git-ignored)
# and in Vercel → Settings → Environment Variables (Preview + Production).

# Transaction pooler (port 6543): used by the app at runtime.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres
# Direct or session pooler (port 5432): used by migrations, the seed and scripts.
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres

# Project URL (public: builds image URLs for the product-images bucket).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key (public: sign-in for /account and /admin, read by src/proxy.ts). Must be in
# Vercel for Production and Preview, then redeploy (NEXT_PUBLIC_ values are built in).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secret key (server/scripts only: uploads product photos). Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...

# Optional: canonical site URL (falls back to Vercel's URL).
# SITE_URL=https://ironbarkfidgets.com.au

# Stripe (test keys until launch). Webhook secret: `stripe listen` locally, the dashboard for Vercel.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Email (Resend). Until ironbarkfidgets.com.au is verified, senders stay on onboarding@resend.dev and
# EMAIL_REDIRECT_TO sends everything to the owner. Always set EMAIL_REDIRECT_TO on previews.
RESEND_API_KEY=re_...
EMAIL_FROM_ORDERS="Ironbark Fidgets <onboarding@resend.dev>"
EMAIL_FROM_HELLO="Ironbark Fidgets <onboarding@resend.dev>"
EMAIL_REPLY_TO=hello@ironbarkfidgets.com.au
ORDER_ALERT_EMAIL=owner@example.com
EMAIL_REDIRECT_TO=owner@example.com
# Random string for signed unsubscribe links (openssl rand -hex 32)
UNSUBSCRIBE_SECRET=

# Phase 5 admin: the only account allowed into /admin (Supabase Auth user, created in the dashboard)
ADMIN_EMAIL=owner@example.com

# Phase 7: Vercel Cron sends "Authorization: Bearer $CRON_SECRET" (openssl rand -hex 32)
CRON_SECRET=
