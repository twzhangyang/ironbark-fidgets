{
  "name": "ironbark-fidgets",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "crop:samples": "tsx scripts/crop-samples.ts",
    "vercel-build": "pnpm db:migrate && next build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "db:check": "tsx --env-file-if-exists=.env.local scripts/db-check.ts",
    "images:upload": "tsx --env-file-if-exists=.env.local scripts/upload-images.ts",
    "race:test": "tsx --env-file-if-exists=.env.local scripts/race-test.ts",
    "email:test": "tsx --env-file-if-exists=.env.local scripts/email-test.ts",
    "email:check": "tsx --env-file-if-exists=.env.local scripts/email-check.ts",
    "email:launch": "tsx --env-file-if-exists=.env.local scripts/launch-email.ts",
    "alerts:back-in-stock": "tsx --env-file-if-exists=.env.local scripts/back-in-stock.ts",
    "seo:indexnow": "tsx scripts/indexnow.ts",
    "admin:check": "tsx --env-file-if-exists=.env.local scripts/admin-check.ts",
    "email:reviews": "tsx --env-file-if-exists=.env.local scripts/review-requests.ts",
    "review:check": "tsx --env-file-if-exists=.env.local scripts/review-check.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@react-email/components": "^1.0.12",
    "@react-pdf/renderer": "4.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "drizzle-orm": "^0.45.4",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.66.0",
    "next": "16.4.3",
    "postgres": "^4.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.37.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sharp": "^0.35.5",
    "stripe": "^23.1.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": "24.x"
  }
}
